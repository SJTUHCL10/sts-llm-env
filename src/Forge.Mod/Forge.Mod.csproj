<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NeowsCompany</AssemblyName>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">$(STS2_GAME_DIR)</Sts2GameDir>
    <Sts2LibDir>$(Sts2GameDir)\data_sts2_windows_x86_64</Sts2LibDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- One DLL for the native mod loader; the core remains independently buildable/testable. -->
    <Compile Include="..\Forge.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Reference Include="sts2"><HintPath>$(Sts2LibDir)\sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2LibDir)\GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2LibDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="VerifyGame" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2LibDir)\sts2.dll')" Text="Set STS2_GAME_DIR or Sts2GameDir to a Slay the Spire 2 v0.111.0 installation." />
  </Target>
</Project>
